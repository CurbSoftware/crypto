{
  "name": "@curbapps/crypto",
  "version": "0.3.0",
  "description": "Auditable end-to-end encryption for CurbApps: Argon2id, AES-256-GCM, XChaCha20-Poly1305, X25519, and Ed25519.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/CurbSoftware/crypto",
  "bugs": {
    "url": "https://github.com/CurbSoftware/crypto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurbSoftware/crypto.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "SPEC.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "vectors"
  ],
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./envelope": "./src/envelope.ts",
    "./keys": "./src/keys.ts",
    "./argon2": "./src/argon2.ts",
    "./device-keys": "./src/device-keys.ts",
    "./domain-keys": "./src/domain-keys.ts",
    "./ecdh": "./src/ecdh.ts",
    "./aes": "./src/aes.ts",
    "./aek": "./src/aek.ts",
    "./recovery-blob": "./src/recovery-blob.ts",
    "./keyring": "./src/keyring.ts",
    "./share": "./src/share.ts",
    "./identity": "./src/identity.ts",
    "./lookup": "./src/lookup.ts",
    "./opaque": "./src/opaque.ts",
    "./operators": "./src/operators.ts",
    "./password-payload": "./src/password-payload.ts",
    "./room": "./src/room.ts",
    "./sealed-file": "./src/sealed-file.ts",
    "./store": "./src/store.ts",
    "./stream": "./src/stream.ts",
    "./xchacha": "./src/xchacha.ts"
  },
  "main": "./src/index.ts",
  "prettier": "./prettier.config.mjs",
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "format": "prettier --check \"**/*.{ts,mjs,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,mjs,json,md}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vectors": "vitest run test/vectors.test.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
